{
  "name": "devcdp",
  "version": "5.0.1",
  "mcpName": "io.github.Dayananda-D/devcdp",
  "description": "MCP server giving AI assistants real Chrome DevTools access — console, network, DOM, source maps, breakpoints and step debugging — with multi-session tab isolation.",
  "license": "MIT",
  "author": {
    "name": "Dayananda D",
    "url": "https://github.com/Dayananda-D"
  },
  "homepage": "https://github.com/Dayananda-D/DevCDP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dayananda-D/DevCDP.git"
  },
  "bugs": {
    "url": "https://github.com/Dayananda-D/DevCDP/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "chrome",
    "devtools",
    "chrome-devtools-protocol",
    "cdp",
    "debugging",
    "debugger",
    "breakpoints",
    "source-maps",
    "network",
    "console",
    "browser-automation",
    "ai"
  ],
  "type": "module",
  "main": "index.js",
  "bin": {
    "devcdp": "index.js"
  },
  "files": [
    "index.js",
    "server.js",
    "src/",
    "extension/",
    "initialize/",
    "initialize_MCP.js",
    "initialize_MCP.bat",
    "debug-chrome.bat",
    "scripts/gen-docs.mjs",
    "scripts/call.mjs",
    "scripts/mcp-probe.mjs",
    "docs/",
    "devcdp.settings.example.json",
    "GETTING-STARTED.md",
    "PRIVACY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "validate": "node test/validate.mjs",
    "test": "node test/validate.mjs && node test/installer.test.mjs && node test/integration.mjs",
    "test:integration": "node test/integration.mjs",
    "test:installer": "node test/installer.test.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "call": "node scripts/call.mjs",
    "probe": "node scripts/mcp-probe.mjs",
    "debug": "node --inspect-brk index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrome-remote-interface": "^0.33.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
