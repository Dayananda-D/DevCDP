{
  "manifest_version": 3,
  "name": "DevCDP Session Marker",
  "version": "5.0.1",
  "description": "Marks and groups the Chrome tabs currently being driven by a DevCDP debugging session.",
  "permissions": ["tabs", "tabGroups"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {}
}
